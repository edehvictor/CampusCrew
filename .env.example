# Omit these values to run the browser-only demo.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GoodDollar's development contracts run on Celo with development G$.
NEXT_PUBLIC_GOODDOLLAR_ENV=development
BOOK_ONE_ESCROW_ADDRESS=

# Optional. Use a public URL for the browser; keep private RPC credentials server-side.
CELO_RPC_URL=
NEXT_PUBLIC_CELO_RPC_URL=
