# Stellar Testnet onboarding uses server-side Supabase access.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stellar Testnet only. Populate after deploying the verified contract and applying the escrow migration.
STELLAR_ESCROW_ENABLED=false
STELLAR_ESCROW_CONTRACT=
STELLAR_ESCROW_WASM_HASH=
STELLAR_ESCROW_RESOLVER=

# Optional phone push and durable payment/notification worker
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EXPERIENCE_WORKER_SECRET=
CAMPUSCREW_WORKER_ORIGIN=http://localhost:3000
